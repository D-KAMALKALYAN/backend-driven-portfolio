# Public (inlined into the browser bundle - the anon key is safe to expose; RLS is the boundary)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SITE_URL=https://backend-driven-portfolio.vercel.app

# Server only - NEVER commit real values
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # used by /api/contact when present; falls back to anon
RESEND_API_KEY=re_...                     # /api/contact notification email
RESEND_FROM="Portfolio <onboarding@resend.dev>"   # a verified sender; the resend.dev address only delivers to your own account email
CONTACT_NOTIFY_TO=you@example.com         # optional; defaults to profiles.email
REVALIDATE_SECRET=change-me               # shared secret for POST /api/revalidate (Supabase database webhook)
CRON_SECRET=change-me-too                 # Vercel attaches it to /api/cron/* requests; the daily analytics rollup refuses without it

# Error reporting (optional). The DSN is a public identifier, not a secret; events
# are tunnelled through /monitoring on this origin so no CSP change is needed.
NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>
# Only for uploading source maps at build time (readable stack traces in Sentry):
# SENTRY_AUTH_TOKEN=sntrys_...   SENTRY_ORG=<org-slug>   SENTRY_PROJECT=portfolio
